{
    "train_batch_size": 32,
    "gradient_accumulation_steps": 1,
    "fp16": {
        "enabled": false
    },
    "zero_optimization": {
        "stage": 1
    },
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 0.0001,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-8,
            "weight_decay": 1e-5
        }
    },
    "scheduler": {
        "type": "WarmupLR",
        "params": {
            "warmup_min_lr": 0,
            "warmup_max_lr": 0.0001,
            "warmup_num_steps": 500
        }
    },
    "gradient_clipping": 1.0
}
